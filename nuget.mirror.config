<?xml version="1.0" encoding="utf-8"?>
<!-- Build from our own mirror only (scripts/restore-from-mirror.sh fills ./packages-mirror):
     dotnet restore src/Node/Node.fsproj -configfile nuget.mirror.config -->
<configuration>
  <packageSources>
    <clear />
    <add key="mirror" value="packages-mirror" />
  </packageSources>
</configuration>
